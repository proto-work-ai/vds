/*
  https://www.prisma.io/blog/organize-your-prisma-schema-with-multi-file-support
*/ 
generator client {
  provider = "prisma-client-js"
  // output   = "../../../../libs/metadb/client/src/lib"
}

datasource db {
  provider  = "postgresql"
}

model MetaEntity {
  id                                              String              @id @default(uuid())
  name                                            String?             @db.VarChar(255)
  title                                           String?             @db.VarChar(255)
  description                                     String?             @db.VarChar(255)
  readonly                                        Boolean?            @default(false)

  // System Types
  type                                            String?             @db.VarChar(255)

  // могут быть системные
  hidden                                          Boolean?            @default(false)

  // сортировка
  order                                           Int?                @db.SmallInt @default(0)

  // todo
  roleable                                        Boolean?            @default(false)
  disable                                         Boolean?            @default(false)

  relations                                       MetaAttribute[]         @relation("typeParent")
  records                                         MetaRecord[]             @relation("recordParent")

  createdAt                                       DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt                                       DateTime            @updatedAt

  children                                        MetaAttribute[]         @relation("attributeParent")

  @@index([title])
  @@map("mdb_entity")
}

model MetaAttribute {
  id                                           String               @id @default(uuid())
  title                                        String?              @db.VarChar(255)
  name                                         String               @db.VarChar(255)
  description                                  String?              @db.VarChar(255)
  // Можно создать несолько значений(SELECT)
  multiple                                     Boolean?             @default(false)

  type                                         String?              @db.VarChar(100)

  required                                     Boolean?             @default(false)
  readonly                                     Boolean?             @default(false)
  order                                        Int?                 @db.SmallInt @default(0)
  disable                                      Boolean?             @default(false)
  hash                                         String?              @db.VarChar(255)
  default                                      String?              @db.Text

  role                                         Int?                 @db.SmallInt
  security                                     Boolean?             @default(false)
  field                                        String?              @db.Text // название поля для редактирования

  values                                       MetaValue[]          @relation("valueAttribute")

  entity                                       MetaEntity?          @relation("attributeParent", fields: [entityId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  entityId                                     String?              @db.VarChar(36)

  relation                                     MetaEntity?              @relation("typeParent", fields: [relationId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  relationId                                   String?              @db.VarChar(36)
  
  relationName                                 String?              @db.VarChar(255)
  relationIsUpdated                            Int?                 @db.SmallInt
  relationIsRemoved                            Int?                 @db.SmallInt

  createdAt                                    DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt                                    DateTime             @updatedAt

  @@index([title])
  @@index([name])
  @@map("mdb_attributes")
}

model MetaRecord {
  id                                  String              @id @default(uuid())

  entity                              MetaEntity?         @relation("recordParent", fields: [entityId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  entityId                            String?             @db.VarChar(36)

  // Relation                         QtValue[]           @relation("mdb_record_parents", fields: [id], references: [parentId, name])
  parent                              MetaRecordRelation[]

  value                               MetaValue[]             @relation("recordChildren")

  // roles                               UserRole[]          @relation("userRoles")
  // permissions                         UserPermission[]    @relation("userPermissions")

  createdAt                           DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt                           DateTime            @updatedAt

  @@index([entityId])
  @@map("mdb_records")
}

model MetaValue {  
  parent            MetaRecord          @relation("recordChildren", fields: [parentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  parentId          String              @db.VarChar(36)
  
  name              String              @db.VarChar(255)

  attribute         MetaAttribute?      @relation("valueAttribute", fields: [attributeId], references: [id], onUpdate: NoAction)
  attributeId       String?             @db.VarChar(36)

  type              Int                 @default(40) @db.SmallInt
  childrenProperty  String?             @db.Text
  order             Int?                @db.SmallInt @default(0)

  bit               Int?                @db.SmallInt

  tinyint           Int?                @db.SmallInt
  smallint          Int?                @db.SmallInt
  int               Int?                
  bigint            BigInt?             @db.BigInt
  float             Float?              

  date              DateTime?           @db.Date
  time              DateTime?           @db.Time(0)
  datetime          DateTime?           @db.Timestamptz(0)

  varchar           String?             @db.VarChar(255)
  text              String?             @db.Text
  json              Json?               
  blob              Bytes?              

  // Relation
  children          MetaRecordRelation[]

  createdAt         DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt

  @@id([parentId, name])
  @@index([attributeId])
  @@index([name])
  @@index([varchar])
  @@map("mdb_value")
}

model MetaRecordRelation {
  value           MetaValue      @relation(fields: [valueParentId, valueName], references: [parentId, name], onDelete: Cascade, onUpdate: Cascade)
  valueParentId   String     @db.VarChar(36)
  valueName       String     @db.VarChar(255)

  // Relation Entry
  record           MetaRecord      @relation(fields: [recordId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  recordId         String     @db.VarChar(36)

  @@id([valueParentId, valueName, recordId])
  @@map("mdb_record_relation")
}

enum AttributeType {
  RELATION
  RELATION_MANY

  BOOLEAN

  TINYINT
  SMALLINT
  INT
  BIGINT
  FLOAT

  TIME
  DATE
  DATETIME

  STRING
  MEMO

  MEDIA
  IMAGE

  SELECT
  JSON

  PARENT
  PARENT_MANY

  PARENT_COUNT // когда надо получить количесво элементов в отношениие
}

