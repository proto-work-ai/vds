# Перевод строк в файлах, которые исполняет Linux.
#
# На Windows git разворачивает LF в CRLF. Для шелл-скрипта это смертельно:
# `#!/bin/sh\r` — интерпретатор с именем «sh\r», которого нет.
*.sh text eol=lf
Dockerfile text eol=lf
*.Dockerfile text eol=lf
*.conf text eol=lf

# Двоичные файлы: git не должен ни трогать в них переводы строк, ни показывать
# их как текст в diff.
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.xlsx binary
*.woff binary
*.woff2 binary
