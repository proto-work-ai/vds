{
  "printWidth": 120,
  "tabWidth": 2,
  "useTabs": false,
  "singleQuote": true,
  "quoteProps": "as-needed",
  "trailingComma": "es5",
  "bracketSpacing": true,
  "bracketSameLine": false,
  "endOfLine": "auto",
  "overrides": [
    {
      "files": "**/*.html",
      "options": {
        "parser": "angular",
        "trailingComma": "none",
        "bracketSpacing": false
      }
    }
  ]
}
