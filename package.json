    "@angular/platform-server": "22.1.7",
    "@angular/router": "22.1.7",
    "@angular/ssr": "22.1.8",
    "@fontsource/playfair-display": "^5.3.0",
    "@ng-icons/core": "^33.2.3",
    "@ng-icons/lucide": "^34.0.0",
