{
  "name": "@shtorivdom/source",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "npx nx run shtorivdom-site:serve --configuration=development",
    "site:serve": "npx nx run shtorivdom-site:serve --configuration=development",
    "site:serve:prod": "npx nx run shtorivdom-site:serve --configuration=production",
    "site:static": "npx nx run shtorivdom-site:serve-static",
    "site:build": "npm run check:tailwind-classes && npx nx run shtorivdom-site:build",
    "site:deploy": "nx build shtorivdom-site && node tools/deploy-site-ftp.mjs --upload",
    "build": "npx nx run shtorivdom-site:build",
    "storybook:start": "npx nx run shtorivdom-storybook:storybook",
    "storybook:build": "npx nx run shtorivdom-storybook:build-storybook",
    "storybook:static": "npx nx run shtorivdom-storybook:static-storybook",
    "sitemap": "node tools/build-sitemap.mjs",
    "mockups": "node tools/mockups/serve.mjs",
    "mockups:site": "node tools/mockups/site-build.mjs && node tools/mockups/serve.mjs",
    "mockups:site:build": "node tools/check-tailwind-classes.mjs && node tools/mockups/check-angular-descriptions.mjs && node tools/mockups/site-build.mjs",
    "mockups:site:check-descriptions": "node tools/mockups/check-angular-descriptions.mjs",
    "check:tailwind-classes": "node tools/check-tailwind-classes.mjs",
    "mockups:site:deploy": "node tools/mockups/site-build.mjs --versions && node tools/mockups/deploy-site-ftp.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "22.1.7",
